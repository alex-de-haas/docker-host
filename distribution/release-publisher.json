      "linux-arm64",
      "linux-x64",
      "win-x64"
    ],
    "inputs": [
      "apps/core/src",
      "apps/cli/src",
      "shared/*.cs",
      "Directory.Build.props",
      "Directory.Build.targets",
      "global.json",
      "scripts/HostyBuildIdentity.cs",
      "distribution-apps.json",
      "distribution/platform-release.json",
      "scripts/install.sh",
      "scripts/install.ps1",
      "distribution/app-source-migrations.json",
      "assets/hosty-brand",
      "skills/hosty-platform",
      "skills/hosty-app-skill",
      ".github/actions/setup-dotnet",
      ".github/workflows/ready-releases.yml",
      "scripts/releases/artifacts.mjs",
      "scripts/releases/evidence.mjs",
      "scripts/releases/native-toolchain.mjs"
    ]
