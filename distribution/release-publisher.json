{
  "schemaVersion": "hosty-publisher.0.1",
  "metadataBranch": "app-releases",
  "sourceBranch": "main",
  "feeds": [
    {
      "id": "daily",
      "label": "Daily",
      "policy": "validated-source"
    },
    {
      "id": "stable",
      "label": "Stable",
      "policy": "manual-promotion",
      "default": true
    }
  ],
  "apps": [
    {
      "id": "hosty.shell",
      "manifest": "apps/shell/manifest.json",
      "profiles": [
        "docker"
      ],
      "sourceInputs": [
        "apps/shell"
      ]
    },
    {
      "id": "hosty.desktop",
      "manifest": "apps/desktop/manifest.json",
      "profiles": [
        "docker"
      ],
      "sourceInputs": [
        "apps/desktop"
      ]
    },
    {
      "id": "hosty.documents",
      "manifest": "apps/documents/manifest.json",
      "profiles": [
        "docker"
      ],
      "sourceInputs": [
        "apps/documents"
      ]
    },
    {
      "id": "hosty.marketplace",
      "manifest": "apps/marketplace/manifest.json",
      "profiles": [
        "docker"
      ],
      "sourceInputs": [
        "apps/marketplace"
      ]
    },
    {
      "id": "com.haas.demo-app",
      "manifest": "apps/demo-app/manifest.json",
      "profiles": [
        "docker"
      ],
      "sourceInputs": [
        "apps/demo-app"
      ]
    },
    {
      "id": "hosty.harness",
      "manifest": "apps/harness/manifest.json",
      "profiles": [
        "docker",
        "local"
      ],
      "sourceInputs": [
        "apps/harness",
        "packages/app-sdk",
        "shared/web",
        "package.json",
        "package-lock.json",
        "Directory.Build.targets"
      ],
      "sourceReusable": false,
      "sourceReuseConstraint": "Host-side setup includes machine toolchains or network dependencies; qualify a new full source revision for each changed release."
    },
    {
      "id": "hosty.telemetry",
      "manifest": "apps/telemetry/manifest.json",
      "profiles": [
        "docker"
      ],
      "sourceInputs": [
        "apps/telemetry"
      ]
    },
    {
      "id": "hosty.whisper",
      "manifest": "apps/whisper/manifest.json",
      "profiles": [
        "local"
      ],
      "sourceInputs": [
        "apps/whisper",
        "packages/app-sdk-dotnet",
        "apps/core/src/Haas.Hosty.Core/SharedDecisionContract.cs",
        "apps/core/src/Haas.Hosty.Core/SharedTaskContract.cs",
        "apps/core/src/Haas.Hosty.Core/SharedAgentSessionContract.cs",
        "apps/core/src/Haas.Hosty.Core/SharedConversationHistoryContract.cs",
        "Directory.Build.props",
        "global.json",
        "Directory.Build.targets"
      ],
      "sourceReusable": false,
      "sourceReuseConstraint": "Host-side setup includes machine toolchains or network dependencies; qualify a new full source revision for each changed release."
    },
    {
      "id": "hosty.opus",
      "manifest": "apps/opus/manifest.json",
      "profiles": [
        "local"
      ],
      "sourceInputs": [
        "apps/opus",
        "packages/app-sdk",
        "package.json",
        "package-lock.json",
        "Directory.Build.targets"
      ],
      "sourceReusable": false,
      "sourceReuseConstraint": "Host-side setup includes machine toolchains or network dependencies; qualify a new full source revision for each changed release."
    }
  ],
  "images": [
    {
      "id": "hosty-shell",
      "appId": "hosty.shell",
      "services": [
        "web"
      ],
      "repository": "ghcr.io/alex-de-haas/hosty-shell",
      "dockerfile": "apps/shell/Dockerfile",
      "inputs": [
        "apps/shell",
        "shared/web"
      ],
      "workspaces": [
        "apps/shell",
        "packages/app-sdk"
      ],
      "platforms": [
        "linux/amd64",
        "linux/arm64"
      ],
      "reusable": true,
      "toolchain": {
        "buildkit": "docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc",
        "contextFormat": "hosty-build-inputs.0.1"
      },
      "reuseConstraint": "Immutable base and archive-integrity dependency closure; offline lifecycle/build steps."
    },
    {
      "id": "hosty-desktop",
      "appId": "hosty.desktop",
      "services": [
