{
  "schemaVersion": "app.0.1",
  "id": "com.example.app",
  "name": "Example App",
  "description": "Example Hosty runtime app manifest. Replace all example values before shipping.",
  "version": "1.0.0",
  "source": {
    "type": "git",
    "repository": "https://github.com/example/example-app"
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "label": "Docker",
      "type": "docker",
      "default": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "app",
      "label": "App",
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": "ghcr.io/example/example-app:1.0.0",
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ],
          "resources": {
            "cpus": 0.5,
            "memory": "512m"
          }
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "web",
      "service": "app",
      "port": "http",
      "public": true
    }
  ],
  "ui": {
    "icon": "boxes",
    "entrypoint": {
      "endpoint": "web",
      "path": "/"
    },
    "navigation": [
      {
        "label": "Overview",
        "path": "/"
      }
    ]
  },
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "app",
        "containerPath": "/app/data"
      }
    ]
  },
  "settings": [
    {
      "key": "APP_BASE_URL",
      "type": "url",
      "required": false,
      "default": "http://localhost:3000",
      "targets": [
        {
          "service": "app",
          "type": "env",
          "name": "APP_BASE_URL"
        }
      ]
    }
  ],
  "dependencies": []
}
