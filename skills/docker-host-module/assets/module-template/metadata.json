{
  "schemaVersion": "0.2",
  "id": "com.example.module",
  "name": "Example Module",
  "description": "Example Docker Host module metadata. Replace all example values before shipping.",
  "version": "1.0.0",
  "containers": [
    {
      "key": "app",
      "image": {
        "repository": "ghcr.io/example/example-module",
        "tag": "1.0.0",
        "pullPolicy": "ifNotPresent"
      },
      "runtime": {
        "ports": [
          {
            "key": "http",
            "containerPort": 3000,
            "protocol": "http"
          }
        ],
        "resources": {
          "cpus": 0.5,
          "memory": "512m"
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "http",
      "container": "app",
      "port": "http",
      "public": true
    }
  ],
  "settings": [
    {
      "key": "APP_BASE_URL",
      "type": "url",
      "required": false,
      "default": "http://localhost:3000",
      "targets": [
        {
          "container": "app",
          "type": "env",
          "name": "APP_BASE_URL"
        }
      ]
    }
  ],
  "storage": {
    "directories": [
      {
        "key": "data",
        "label": "Data",
        "description": "Persistent module data.",
        "purpose": "data",
        "required": true,
        "targets": [
          {
            "container": "app",
            "containerPath": "/app/data",
            "writable": true
          }
        ],
        "mount": {
          "recommended": true,
          "type": "bind",
          "modulePath": "data"
        }
      }
    ],
    "mountCollections": []
  },
  "ui": {
    "category": "Apps",
    "icon": "boxes",
    "entrypoint": {
      "portKey": "http",
      "path": "/"
    },
    "navigation": [
      {
        "label": "Overview",
        "path": "/"
      }
    ]
  }
}
