{
  "name": "hosty-monorepo",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/demo-app",
    "apps/marketplace",
    "apps/shell",
    "apps/telemetry-ui",
    "packages/app-sdk"
  ],
  "overrides": {
    "next": {
      ".": "16.2.10",
      "postcss": "8.5.16"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "check-versions": "node scripts/check-versions.mjs",
    "lint": "npm run shell:lint && npm run demo-app:lint && npm run marketplace:lint && npm run telemetry-ui:lint",
    "build": "npm run core:build && npm run cli:build && npm run telemetry-backend:build && npm run marketplace:build && npm run telemetry-ui:build && npm run shell:build && npm run demo-app:build",
    "test": "npm run sdk:test && npm run sdk:dotnet:test && npm run core:test && npm run cli:test && npm run telemetry-backend:test && npm run marketplace:test && npm run telemetry-ui:test && npm run shell:test",
    "ci": "npm run lint && npm run build && npm run test",
    "core:dev": "dotnet run --project apps/core/src/Haas.Hosty.Core/Haas.Hosty.Core.csproj --launch-profile dev",
    "core:build": "dotnet build apps/core/src/Haas.Hosty.Core/Haas.Hosty.Core.csproj",
    "core:test": "dotnet test apps/core/tests/Haas.Hosty.Core.Tests/Haas.Hosty.Core.Tests.csproj",
    "cli:build": "dotnet build apps/cli/src/Haas.Hosty.Cli/Haas.Hosty.Cli.csproj",
    "cli:test": "dotnet test apps/cli/tests/Haas.Hosty.Cli.Tests/Haas.Hosty.Cli.Tests.csproj",
    "telemetry-backend:dev": "dotnet run --project apps/telemetry-backend/src/Haas.Hosty.TelemetryBackend/Haas.Hosty.TelemetryBackend.csproj",
    "telemetry-backend:build": "dotnet build apps/telemetry-backend/src/Haas.Hosty.TelemetryBackend/Haas.Hosty.TelemetryBackend.csproj",
    "telemetry-backend:test": "dotnet test apps/telemetry-backend/tests/Haas.Hosty.TelemetryBackend.Tests/Haas.Hosty.TelemetryBackend.Tests.csproj",
    "telemetry-backend:docker:build": "docker build -f apps/telemetry-backend/Dockerfile -t ghcr.io/alex-de-haas/hosty-telemetry-backend:latest .",
    "marketplace:dev": "npm run dev --workspace @haas/hosty-marketplace",
    "marketplace:build": "npm run build --workspace @haas/hosty-marketplace",
    "marketplace:lint": "npm run lint --workspace @haas/hosty-marketplace",
    "marketplace:test": "npm run test --workspace @haas/hosty-marketplace",
    "marketplace:docker:build": "docker build -f apps/marketplace/Dockerfile -t ghcr.io/alex-de-haas/hosty-marketplace:latest .",
    "telemetry-ui:dev": "npm run dev --workspace @haas/hosty-telemetry-ui",
    "telemetry-ui:build": "npm run build --workspace @haas/hosty-telemetry-ui",
    "telemetry-ui:start": "npm run start --workspace @haas/hosty-telemetry-ui",
    "telemetry-ui:lint": "npm run lint --workspace @haas/hosty-telemetry-ui",
    "telemetry-ui:test": "npm run test --workspace @haas/hosty-telemetry-ui",
    "telemetry-ui:docker:build": "docker build -f apps/telemetry-ui/Dockerfile -t ghcr.io/alex-de-haas/hosty-telemetry-ui:latest .",
    "shell:dev": "npm run dev --workspace @haas/hosty-shell",
    "shell:build": "npm run build --workspace @haas/hosty-shell",
    "shell:start": "npm run start --workspace @haas/hosty-shell",
    "shell:lint": "npm run lint --workspace @haas/hosty-shell",
    "shell:test": "npm run test --workspace @haas/hosty-shell",
    "shell:docker:build": "docker build -f apps/shell/Dockerfile -t ghcr.io/alex-de-haas/hosty-shell:latest .",
    "shell:docker:build:local": "docker build -f apps/shell/Dockerfile -t hosty-shell:dev .",
    "demo-app:dev": "npm run dev --workspace @haas/hosty-demo-app",
    "demo-app:build": "npm run build --workspace @haas/hosty-demo-app",
    "demo-app:start": "npm run start --workspace @haas/hosty-demo-app",
    "demo-app:lint": "npm run lint --workspace @haas/hosty-demo-app",
    "demo-app:docker:build": "docker build -f apps/demo-app/Dockerfile -t ghcr.io/alex-de-haas/demo-app:latest .",
    "demo-app:docker:build:local": "docker build -f apps/demo-app/Dockerfile -t hosty-demo-app:dev .",
    "sdk:test": "npm run test --workspace @hosty-sdk/app",
    "sdk:dotnet:test": "dotnet test packages/app-sdk-dotnet/HostySdk.App.Tests/HostySdk.App.Tests.csproj"
  }
}
