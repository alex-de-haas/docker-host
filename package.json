{
  "name": "docker-host-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/host",
    "modules/demo-module"
  ],
  "scripts": {
    "dev": "npm run host:dev",
    "build": "npm run host:build",
    "lint": "npm run host:lint",
    "host:dev": "npm run dev --workspace @haas/docker-host-app",
    "host:build": "npm run build --workspace @haas/docker-host-app",
    "host:start": "npm run start --workspace @haas/docker-host-app",
    "host:lint": "npm run lint --workspace @haas/docker-host-app",
    "host:test": "npm run test --workspace @haas/docker-host-app",
    "demo-module:dev": "npm run dev --workspace @haas/docker-host-demo-module",
    "demo-module:build": "npm run build --workspace @haas/docker-host-demo-module",
    "demo-module:start": "npm run start --workspace @haas/docker-host-demo-module",
    "demo-module:lint": "npm run lint --workspace @haas/docker-host-demo-module",
    "demo-module:docker:build": "docker build -f modules/demo-module/Dockerfile -t ghcr.io/alex-de-haas/demo-module:latest .",
    "cli:build": "dotnet build apps/cli/src/Haas.DockerHost.Cli/Haas.DockerHost.Cli.csproj",
    "cli:test": "dotnet test apps/cli/tests/Haas.DockerHost.Cli.Tests/Haas.DockerHost.Cli.Tests.csproj",
    "ci": "npm run host:lint && npm run host:test && npm run host:build && npm run cli:build && npm run cli:test"
  }
}
