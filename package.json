{
  "name": "docker-host-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/host"
  ],
  "scripts": {
    "dev": "npm run host:dev",
    "build": "npm run host:build",
    "lint": "npm run host:lint",
    "host:dev": "npm run dev --workspace @haas/docker-host-app",
    "host:build": "npm run build --workspace @haas/docker-host-app",
    "host:start": "npm run start --workspace @haas/docker-host-app",
    "host:lint": "npm run lint --workspace @haas/docker-host-app",
    "cli:build": "dotnet build apps/cli/src/Haas.DockerHost.Cli/Haas.DockerHost.Cli.csproj",
    "cli:test": "dotnet build apps/cli/tests/Haas.DockerHost.Cli.Tests/Haas.DockerHost.Cli.Tests.csproj",
    "ci": "npm run host:lint && npm run host:build && npm run cli:build && npm run cli:test"
  }
}
