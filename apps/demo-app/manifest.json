{
  "schemaVersion": "app.0.1",
  "id": "com.haas.demo-app",
  "name": "Demo App",
  "description": "Hosty-aware demo runtime app for validating lifecycle, settings, storage, external mounts, identity, and app-owned role flows.",
  "version": "0.18.0",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/docker-host.git",
    "branch": "main"
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    },
    {
      "key": "sandbox-dev",
      "type": "docker",
      "development": true
    },
    {
      "key": "sandbox-artifact",
      "type": "docker"
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "backend",
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/demo-app",
            "tag": "latest"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http"
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 60
          }
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/demo-app",
          "setup": "npm install",
          "command": "npm run dev:backend",
          "environment": {
            "NEXT_DIST_DIR": ".next-dev-backend"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http"
            }
          ]
        },
        "sandbox-dev": {
          "type": "docker",
          "image": {
            "repository": "hosty-sandbox-demo-dev",
            "tag": "0.18.0"
          },
          "artifact": "source",
          "sourceMount": {
            "path": ".",
            "target": "/workspace",
            "mode": "ro",
            "caches": [
              "node_modules",
              "apps/demo-app/node_modules",
              "apps/demo-app/.next-sandbox-backend"
            ],
            "generatedFiles": [
              "apps/demo-app/next-env.d.ts"
            ]
          },
          "workingDirectory": "apps/demo-app",
          "setup": "node /opt/hosty/prepare.mjs /workspace",
          "command": "npm run dev:backend",
          "environment": {
            "NEXT_DIST_DIR": ".next-sandbox-backend",
            "NEXT_TELEMETRY_DISABLED": "1",
            "PORT": "3000"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http"
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 60
          }
        },
        "sandbox-artifact": {
          "type": "docker",
          "image": {
            "repository": "hosty-sandbox-demo-artifact",
            "tag": "0.18.0"
          },
          "environment": {
            "NEXT_TELEMETRY_DISABLED": "1"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http"
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 60
          }
        }
      }
    },
    {
      "key": "frontend",
      "dependsOn": [
        "backend"
      ],
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/demo-app",
            "tag": "latest"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 60
          }
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/demo-app",
          "setup": "npm install",
          "command": "npm run dev:frontend",
          "environment": {
            "NEXT_DIST_DIR": ".next-dev-frontend"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ]
        },
        "sandbox-dev": {
          "type": "docker",
          "image": {
            "repository": "hosty-sandbox-demo-dev",
            "tag": "0.18.0"
          },
          "artifact": "source",
          "sourceMount": {
            "path": ".",
            "target": "/workspace",
            "mode": "ro",
            "caches": [
              "node_modules",
              "apps/demo-app/node_modules",
              "apps/demo-app/.next-sandbox-frontend"
            ],
            "generatedFiles": [
              "apps/demo-app/next-env.d.ts"
            ]
          },
          "workingDirectory": "apps/demo-app",
          "setup": "node /opt/hosty/prepare.mjs /workspace",
          "command": "npm run dev:frontend",
          "environment": {
            "NEXT_DIST_DIR": ".next-sandbox-frontend",
            "NEXT_TELEMETRY_DISABLED": "1",
            "PORT": "3000"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http"
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 60
          }
        },
        "sandbox-artifact": {
          "type": "docker",
          "image": {
            "repository": "hosty-sandbox-demo-artifact",
            "tag": "0.18.0"
          },
          "environment": {
            "NEXT_TELEMETRY_DISABLED": "1"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http"
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 60
          }
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "api",
      "service": "backend",
      "port": "http",
      "protocol": "http",
      "public": true
    },
    {
      "key": "http",
      "service": "frontend",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/"
    },
    "navigation": [
      {
        "label": "Overview",
        "path": "/",
        "iconAsset": "assets/nav/overview.svg"
      },
      {
        "label": "People",
        "path": "/people",
        "iconAsset": "assets/nav/people.svg"
      },
      {
        "label": "Roles",
        "path": "/roles",
        "iconAsset": "assets/nav/roles.svg"
      },
      {
        "label": "Settings",
        "path": "/settings",
        "iconAsset": "assets/nav/settings.svg"
      },
      {
        "label": "Composition fixture",
        "path": "/composition"
      },
      {
        "label": "Backend view",
        "endpoint": "api",
        "path": "/composition/view"
      }
    ],
    "panels": [
      {
        "id": "session",
        "label": "Session",
        "endpoint": "http",
        "path": "/panel",
        "icon": "contact-round"
      }
    ]
  },
  "settings": [
    {
      "key": "DEMO_GREETING",
      "type": "string",
      "default": "Hello from Hosty",
      "label": "Greeting",
      "description": "Message shown on the demo app's home page."
    },
    {
      "key": "DEMO_RELEASE_CHANNEL",
      "type": "string",
      "default": "local",
      "label": "Release channel",
      "description": "Which build channel the demo reports (local, stable, beta)."
    },
    {
      "key": "DEMO_REFRESH_SECONDS",
      "type": "number",
      "default": "30",
      "label": "Refresh interval (seconds)",
      "description": "How often the demo page polls the backend for updates."
    },
    {
      "key": "DEMO_AUTH_PREVIEW",
      "type": "boolean",
      "default": "true",
      "label": "Auth preview",
      "description": "Enable the experimental authentication preview panel."
    }
  ],
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "backend",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "sandbox-dev",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "sandbox-artifact",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      }
    ]
  },
  "externalMounts": {
    "catalogRoots": {
      "kind": "host-path",
      "multiple": true,
      "mode": "rw",
      "required": false
    }
  },
  "capabilities": [
    "backup",
    "logs"
  ],
  "catalogMetadata": {
    "publisher": {
      "name": "Haas",
      "url": "https://github.com/alex-de-haas",
      "email": "demo@example.com"
    },
    "category": "Developer Tools",
    "tags": [
      "demo",
      "example",
      "reference"
    ],
    "icon": "assets/icon.svg",
    "license": "AGPL-3.0-only",
    "links": {
      "website": "https://github.com/alex-de-haas/docker-host",
      "docs": "https://github.com/alex-de-haas/docker-host/tree/main/apps/demo-app"
    },
    "summary": "A reference Hosty runtime app used to demonstrate the platform and this catalog.",
    "descriptionFile": "docs/store.md"
  },
  "interfaces": {
    "mcp": [
      {
        "key": "default",
        "endpoint": "api",
        "path": "/api/mcp"
      }
    ]
  },
  "agent": {
    "skillFile": "docs/agent.md"
  },
  "optionalCorePermissions": [
    "apps.panels.read"
  ],
  "sandbox": {
    "protocol": "hosty-sandbox-v1",
    "roles": [
      "admin",
      "operator",
      "viewer"
    ],
    "permissions": [
      "demo.health.read",
      "demo.config.read",
      "demo.people.read",
      "demo.directory.read",
      "demo.roles.read",
      "demo.roles.manage",
      "demo.settings.preview"
    ],
    "generatedSourceFiles": {
      "sandbox-dev": [
        "apps/demo-app/next-env.d.ts"
      ]
    }
  }
}
