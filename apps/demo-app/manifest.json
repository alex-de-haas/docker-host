{
  "schemaVersion": "app.0.1",
  "id": "com.haas.demo-app",
  "name": "Demo App",
  "description": "Hosty-aware demo runtime app for validating lifecycle, settings, storage, external mounts, identity, and app-owned role flows.",
  "version": "0.7.0",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/docker-host.git",
    "branch": "main"
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "backend",
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/demo-app",
            "tag": "latest"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http"
            }
          ]
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/demo-app",
          "setup": "npm install",
          "command": "npm run dev:backend",
          "environment": {
            "NEXT_DIST_DIR": ".next-dev-backend"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http"
            }
          ]
        }
      }
    },
    {
      "key": "frontend",
      "dependsOn": [
        "backend"
      ],
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/demo-app",
            "tag": "latest"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ]
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/demo-app",
          "setup": "npm install",
          "command": "npm run dev:frontend",
          "environment": {
            "NEXT_DIST_DIR": ".next-dev-frontend"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ]
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "api",
      "service": "backend",
      "port": "http",
      "protocol": "http",
      "public": true
    },
    {
      "key": "http",
      "service": "frontend",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/"
    },
    "navigation": [
      {
        "label": "Overview",
        "path": "/",
        "iconAsset": "assets/nav/overview.svg"
      },
      {
        "label": "People",
        "path": "/people",
        "iconAsset": "assets/nav/people.svg"
      },
      {
        "label": "Roles",
        "path": "/roles",
        "iconAsset": "assets/nav/roles.svg"
      },
      {
        "label": "Settings",
        "path": "/settings",
        "iconAsset": "assets/nav/settings.svg"
      }
    ]
  },
  "settings": [
    {
      "key": "DEMO_GREETING",
      "type": "string",
      "default": "Hello from Hosty",
      "label": "Greeting",
      "description": "Message shown on the demo app's home page."
    },
    {
      "key": "DEMO_RELEASE_CHANNEL",
      "type": "string",
      "default": "local",
      "label": "Release channel",
      "description": "Which build channel the demo reports (local, stable, beta)."
    },
    {
      "key": "DEMO_REFRESH_SECONDS",
      "type": "number",
      "default": "30",
      "label": "Refresh interval (seconds)",
      "description": "How often the demo page polls the backend for updates."
    },
    {
      "key": "DEMO_AUTH_PREVIEW",
      "type": "boolean",
      "default": "true",
      "label": "Auth preview",
      "description": "Enable the experimental authentication preview panel."
    }
  ],
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "backend",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_DATA_DIR"
      }
    ]
  },
  "externalMounts": {
    "catalogRoots": {
      "kind": "host-path",
      "multiple": true,
      "mode": "rw",
      "required": false
    }
  },
  "capabilities": [
    "backup",
    "logs"
  ],
  "catalogMetadata": {
    "publisher": {
      "name": "Haas",
      "url": "https://github.com/alex-de-haas",
      "email": "demo@example.com"
    },
    "category": "Developer Tools",
    "tags": [
      "demo",
      "example",
      "reference"
    ],
    "icon": "assets/icon.svg",
    "license": "AGPL-3.0-only",
    "links": {
      "website": "https://github.com/alex-de-haas/docker-host",
      "docs": "https://github.com/alex-de-haas/docker-host/tree/main/apps/demo-app"
    },
    "summary": "A reference Hosty runtime app used to demonstrate the platform and this catalog.",
    "descriptionFile": "docs/store.md"
  },
  "interfaces": {
    "mcp": [
      {
        "key": "default",
        "endpoint": "api",
        "path": "/api/mcp"
      }
    ]
  }
}
