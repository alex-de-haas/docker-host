{
  "schemaVersion": "app.0.1",
  "id": "com.haas.demo-app",
  "name": "Demo App",
  "description": "Hosty-aware demo runtime app for validating lifecycle, settings, storage, identity, and app-owned role flows.",
  "version": "0.3.0",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/docker-host.git",
    "branch": "main"
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "dev",
      "type": "localCommand"
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "backend",
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/demo-app",
            "tag": "latest",
            "pullPolicy": "always"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http"
            }
          ]
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/demo-app",
          "command": "npm run dev:backend",
          "environment": {
            "NEXT_DIST_DIR": ".next-dev-backend"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http"
            }
          ]
        }
      }
    },
    {
      "key": "frontend",
      "dependsOn": ["backend"],
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/demo-app",
            "tag": "latest",
            "pullPolicy": "always"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ]
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/demo-app",
          "command": "npm run dev:frontend",
          "environment": {
            "NEXT_DIST_DIR": ".next-dev-frontend"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ]
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "api",
      "service": "backend",
      "port": "http",
      "protocol": "http",
      "public": true
    },
    {
      "key": "http",
      "service": "frontend",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/"
    },
    "navigation": [
      {
        "label": "Overview",
        "path": "/"
      },
      {
        "label": "People",
        "path": "/people"
      },
      {
        "label": "Roles",
        "path": "/roles"
      },
      {
        "label": "Settings",
        "path": "/settings"
      }
    ]
  },
  "settings": [
    {
      "key": "DEMO_GREETING",
      "type": "string",
      "default": "Hello from Hosty"
    },
    {
      "key": "DEMO_RELEASE_CHANNEL",
      "type": "string",
      "default": "local"
    },
    {
      "key": "DEMO_REFRESH_SECONDS",
      "type": "number",
      "default": "30"
    },
    {
      "key": "DEMO_AUTH_PREVIEW",
      "type": "boolean",
      "default": "true"
    }
  ],
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "backend",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_DATA_DIR"
      }
    ]
  },
  "capabilities": ["open", "update", "restart", "stop", "remove", "backup", "restore", "logs"]
}
