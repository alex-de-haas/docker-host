<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Version is shared with Core via the root Directory.Build.props (platform tier). -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>hosty</AssemblyName>
    <RootNamespace>Haas.Hosty.Cli</RootNamespace>
    <!-- Native AOT. Implies self-contained publish and trim/AOT analyzers on every build. All JSON
         routes through the CliJson helper and its per-command source-generated JsonSerializerContext
         types (see Commands/CliJson.cs), so `dotnet publish -r <rid>` produces a single native
         executable with no IL2026/IL3050 warnings; `dotnet build`/`dotnet test` stay IL (no native
         toolchain needed). -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
</Project>
