{
  "schemaVersion": "app.0.1",
  "id": "hosty.telemetry",
  "name": "Hosty Telemetry",
  "description": "OpenTelemetry collector + telemetry backend: receives OTLP from Hosty runtime apps, stores metrics/logs/traces in an embedded SQLite store, and serves the query API Core's read proxy reads.",
  "version": "0.2.0",
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "collector",
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "otel/opentelemetry-collector-contrib",
            "tag": "0.155.0"
          },
          "ports": [
            {
              "key": "otlp-http",
              "containerPort": 4318,
              "localPort": 4318,
              "protocol": "http",
              "expose": "host"
            },
            {
              "key": "metrics",
              "containerPort": 9464,
              "protocol": "http"
            }
          ]
        }
      }
    },
    {
      "key": "backend",
      "dependsOn": ["collector"],
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/hosty-telemetry-backend",
            "tag": "latest"
          },
          "environment": {
            "HOSTY_TELEMETRY_LOGS_FILE": "/etc/otelcol-contrib/otlp-logs/logs.jsonl",
            "HOSTY_TELEMETRY_TRACES_FILE": "/etc/otelcol-contrib/otlp-traces/traces.jsonl",
            "HOSTY_TELEMETRY_DB_PATH": "/etc/otelcol-contrib/store/telemetry.db",
            "HOSTY_TELEMETRY_QUERY_PORT": "8080"
          },
          "ports": [
            {
              "key": "query",
              "containerPort": 8080,
              "protocol": "http"
            }
          ]
        }
      }
    }
  ],
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "containerPath": "/etc/otelcol-contrib"
      }
    ]
  },
  "endpoints": [
    {
      "key": "otlp-http",
      "service": "collector",
      "port": "otlp-http",
      "protocol": "http"
    },
    {
      "key": "metrics",
      "service": "collector",
      "port": "metrics",
      "protocol": "http"
    },
    {
      "key": "query",
      "service": "backend",
      "port": "query",
      "protocol": "http"
    }
  ],
  "capabilities": ["restart", "stop", "logs"]
}
