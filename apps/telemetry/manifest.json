{
  "schemaVersion": "app.0.1",
  "id": "hosty.telemetry",
  "name": "Hosty Telemetry",
  "description": "OpenTelemetry collector + telemetry backend + UI: receives OTLP from Hosty runtime apps, stores metrics/logs/traces in an embedded SQLite store, and serves the Metrics/Structured logs/Traces pages that read the backend directly.",
  "version": "0.3.0",
  "role": "system",
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "collector",
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "otel/opentelemetry-collector-contrib",
            "tag": "0.155.0"
          },
          "ports": [
            {
              "key": "otlp-http",
              "containerPort": 4318,
              "localPort": 4318,
              "protocol": "http",
              "expose": "host"
            },
            {
              "key": "metrics",
              "containerPort": 9464,
              "protocol": "http"
            }
          ]
        }
      }
    },
    {
      "key": "backend",
      "dependsOn": ["collector"],
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/hosty-telemetry-backend",
            "tag": "0.3.0"
          },
          "environment": {
            "HOSTY_TELEMETRY_LOGS_FILE": "/etc/otelcol-contrib/otlp-logs/logs.jsonl",
            "HOSTY_TELEMETRY_TRACES_FILE": "/etc/otelcol-contrib/otlp-traces/traces.jsonl",
            "HOSTY_TELEMETRY_DB_PATH": "/etc/otelcol-contrib/store/telemetry.db",
            "HOSTY_TELEMETRY_QUERY_PORT": "8080"
          },
          "ports": [
            {
              "key": "query",
              "containerPort": 8080,
              "protocol": "http"
            }
          ]
        }
      }
    },
    {
      "key": "ui",
      "dependsOn": ["backend"],
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/hosty-telemetry-ui",
            "tag": "0.3.0"
          },
          "environment": {
            "PORT": "3000",
            "HOSTNAME": "0.0.0.0"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 30,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 10
          }
        }
      }
    }
  ],
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "containerPath": "/etc/otelcol-contrib"
      }
    ]
  },
  "endpoints": [
    {
      "key": "otlp-http",
      "service": "collector",
      "port": "otlp-http",
      "protocol": "http"
    },
    {
      "key": "metrics",
      "service": "collector",
      "port": "metrics",
      "protocol": "http"
    },
    {
      "key": "query",
      "service": "backend",
      "port": "query",
      "protocol": "http"
    },
    {
      "key": "http",
      "service": "ui",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/metrics"
    },
    "navigation": [
      { "label": "Metrics", "endpoint": "http", "path": "/metrics" },
      { "label": "Structured logs", "endpoint": "http", "path": "/logs" },
      { "label": "Traces", "endpoint": "http", "path": "/traces" }
    ]
  },
  "capabilities": ["restart", "stop", "logs", "open"],
  "catalogMetadata": {
    "icon": "assets/icon.svg"
  }
}
