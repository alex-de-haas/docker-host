{
  "schemaVersion": "app.0.1",
  "id": "hosty.documents",
  "name": "Hosty Documents",
  "description": "Current application documentation, plans and workspace progress from Git.",
  "version": "0.9.1",
  "role": "system",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/docker-host.git",
    "branch": "main",
    "paths": [
      "apps/documents"
    ]
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "api",
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/hosty-documents",
            "tag": "0.9.1"
          },
          "environment": {
            "PORT": "3000",
            "HOSTNAME": "0.0.0.0",
            "HOSTY_APP_CACHE_DIR": "/var/cache/hosty-documents"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 30,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 10
          }
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/documents",
          "setup": "npm install",
          "command": "npm run dev",
          "ports": [
            {
              "key": "http",
              "containerPort": 3600,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3600,
            "path": "/healthz",
            "timeoutSeconds": 5
          }
        }
      }
    }
  ],
  "cache": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "containerPath": "/var/cache/hosty-documents"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_CACHE_DIR"
      }
    ]
  },
  "endpoints": [
    {
      "key": "http",
      "service": "api",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/"
    },
    "navigation": [
      {
        "label": "Home",
        "endpoint": "http",
        "path": "/",
        "iconAsset": "assets/nav/book-open.svg"
      },
      {
        "label": "Vision",
        "endpoint": "http",
        "path": "/vision",
        "iconAsset": "assets/nav/compass.svg"
      },
      {
        "label": "Ideas",
        "endpoint": "http",
        "path": "/ideas",
        "iconAsset": "assets/nav/lightbulb.svg"
      },
      {
        "label": "Features",
        "endpoint": "http",
        "path": "/features",
        "iconAsset": "assets/nav/file-text.svg"
      },
      {
        "label": "Plans",
        "endpoint": "http",
        "path": "/plans",
        "iconAsset": "assets/nav/list-checks.svg"
      },
      {
        "label": "Reviews",
        "endpoint": "http",
        "path": "/reviews",
        "iconAsset": "assets/nav/book-open.svg"
      },
      {
        "label": "Tooling",
        "endpoint": "http",
        "path": "/tooling",
        "iconAsset": "assets/nav/file-text.svg"
      }
    ]
  },
  "interfaces": {
    "mcp": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/mcp"
      }
    ]
  },
  "agent": {
    "skills": [
      {
        "key": "default",
        "path": "skills/hosty-documents"
      }
    ]
  },
  "capabilities": [
    "logs"
  ],
  "catalogMetadata": {
    "icon": "assets/icon.svg"
  },
  "corePermissions": [
    "apps.sources.read"
  ],
  "optionalCorePermissions": [
    "providers.assistant",
    "apps.panels.read",
    "providers.translation"
  ]
}
