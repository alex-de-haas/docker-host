{
  "schemaVersion": "app.0.1",
  "id": "hosty.shell",
  "name": "Hosty Shell",
  "description": "Hosty browser management shell.",
  "version": "0.57.0",
  "role": "system",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/docker-host.git",
    "branch": "main"
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "web",
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/hosty-shell",
            "tag": "latest"
          },
          "environment": {
            "PORT": "3000",
            "HOSTNAME": "0.0.0.0"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "localPort": 7171,
              "protocol": "http",
              "public": true
            }
          ]
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/shell",
          "setup": "npm install",
          "command": "npm run dev",
          "environment": {
            "HOSTNAME": "0.0.0.0"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "localPort": 7171,
              "protocol": "http",
              "public": true
            }
          ]
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "web",
      "service": "web",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "capabilities": ["logs"],
  "catalogMetadata": {
    "publisher": {
      "name": "Haas",
      "url": "https://github.com/alex-de-haas",
      "email": "a.zayats@outlook.com"
    },
    "category": "Utilities",
    "tags": ["shell", "web-ui", "management", "first-party"],
    "icon": "assets/icon.svg",
    "license": "AGPL-3.0-only",
    "links": {
      "website": "https://github.com/alex-de-haas/docker-host",
      "docs": "https://github.com/alex-de-haas/docker-host/tree/main/apps/shell"
    },
    "summary": "The browser management UI for a Hosty host: installed apps, settings, updates, and users.",
    "descriptionFile": "docs/store.md"
  }
}
