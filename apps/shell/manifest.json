{
  "schemaVersion": "app.0.1",
  "id": "hosty.shell",
  "name": "Hosty Shell",
  "description": "Hosty browser management shell.",
  "version": "0.41.2",
  "role": "system",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/docker-host.git",
    "branch": "main"
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "web",
      "runtimes": {
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/hosty-shell",
            "tag": "latest"
          },
          "environment": {
            "PORT": "3000",
            "HOSTNAME": "0.0.0.0"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "localPort": 7171,
              "protocol": "http",
              "public": true
            }
          ]
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/shell",
          "setup": "npm install",
          "command": "npm run dev",
          "environment": {
            "HOSTNAME": "0.0.0.0"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "localPort": 7171,
              "protocol": "http",
              "public": true
            }
          ]
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "web",
      "service": "web",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "capabilities": ["open", "update", "restart", "stop", "logs"],
  "catalogMetadata": {
    "icon": "assets/icon.svg"
  }
}
