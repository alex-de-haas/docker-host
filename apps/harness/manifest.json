{
  "schemaVersion": "app.0.1",
  "id": "hosty.harness",
  "name": "Hosty Harness",
  "description": "Hosty conversation and task coordination with independently installed local agent providers.",
  "version": "0.100.0",
  "role": "system",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/docker-host.git",
    "branch": "main",
    "paths": [
      "apps/harness",
      "packages/app-sdk",
      "shared/web",
      "package.json",
      "package-lock.json",
      "scripts/npm-workspace.mjs"
    ]
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    },
    {
      "key": "docker-dev",
      "type": "docker",
      "development": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "api",
      "runtimes": {
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/harness",
          "command": "node scripts/local-runtime.mjs start api",
          "ports": [
            {
              "key": "http",
              "containerPort": 3400,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3400,
            "path": "/healthz",
            "timeoutSeconds": 5
          },
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "native",
            "NODE_ENV": "production"
          },
          "setup": "node scripts/local-runtime.mjs prepare"
        },
        "docker": {
          "type": "docker",
          "image": "ghcr.io/alex-de-haas/hosty-harness:0.100.0",
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "docker",
            "PORT": "3400"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3400,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3400/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 20
          }
        },
        "docker-dev": {
          "type": "docker",
          "image": {
            "repository": "node",
            "tag": "24-bookworm-slim"
          },
          "artifact": "source",
          "sourceMount": {
            "path": ".",
            "target": "/workspace",
            "mode": "ro",
            "caches": [
              "apps/harness/.local-runtime"
            ]
          },
          "workingDirectory": "apps/harness",
          "setup": "node scripts/local-runtime.mjs prepare",
          "command": "node scripts/local-runtime.mjs start api",
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "docker",
            "NODE_ENV": "production",
            "NEXT_TELEMETRY_DISABLED": "1",
            "HOME": "/tmp",
            "PORT": "3400"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3400,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3400/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 60
          }
        }
      },
      "injection": {
        "settings": []
      }
    }
  ],
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "api",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_DATA_DIR",
        "service": "api"
      },
      {
        "runtime": "docker-dev",
        "service": "api",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      }
    ]
  },
  "cache": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "api",
        "containerPath": "/app/cache",
        "environment": "HOSTY_APP_CACHE_DIR"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_CACHE_DIR",
        "service": "api"
      },
      {
        "runtime": "docker-dev",
        "service": "api",
        "containerPath": "/app/cache",
        "environment": "HOSTY_APP_CACHE_DIR"
      }
    ]
  },
  "endpoints": [
    {
      "key": "http",
      "service": "api",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "interfaces": {
    "assistant": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/assistant/v1",
        "version": 1,
        "capabilities": [
          "attachments"
        ]
      }
    ],
    "tasks": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/tasks/v1",
        "version": 1,
        "capabilities": [
          "markdown",
          "review",
          "resources",
          "events",
          "removal",
          "parent-child",
          "prerequisites",
          "delegated-review"
        ]
      }
    ],
    "task-executor": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/task-executor/v1",
        "version": 1,
        "capabilities": [
          "markdown",
          "options",
          "cancellation",
          "configuration-ref",
          "session-workflow"
        ]
      }
    ],
    "conversation-history": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/history/v1",
        "version": 1,
        "capabilities": [
          "history.read",
          "history.search.text",
          "history.sharing",
          "history.attachments",
          "history.changes",
          "history.tool-events",
          "history.usage"
        ]
      }
    ],
    "agent-sessions": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/agent-sessions/v1",
        "version": 1,
        "capabilities": [
          "session.read",
          "session.list",
          "run.cancel",
          "run.events"
        ]
      }
    ]
  },
  "capabilities": [
    "logs"
  ],
  "catalogMetadata": {
    "icon": "assets/icon.svg",
    "summary": "Admin-only Hosty assistant with Docker production and managed development runtimes."
  },
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/chats"
    },
    "settings": {
      "endpoint": "http",
      "path": "/settings"
    },
    "navigation": [
      {
        "label": "Sessions",
        "endpoint": "http",
        "path": "/chats",
        "iconAsset": "assets/nav/message-square.svg"
      },
      {
        "label": "Tasks",
        "endpoint": "http",
        "path": "/tasks",
        "iconAsset": "assets/nav/clipboard-check.svg"
      },
      {
        "label": "Decisions",
        "endpoint": "http",
        "path": "/decisions",
        "iconAsset": "assets/nav/list-todo.svg"
      },
      {
        "label": "Feedback",
        "endpoint": "http",
        "path": "/feedback",
        "feedbackReview": true,
        "iconAsset": "assets/nav/message-square-warning.svg"
      },
      {
        "label": "Pull requests",
        "endpoint": "http",
        "path": "/pull-requests",
        "iconAsset": "assets/nav/git-pull-request.svg"
      }
    ],
    "panels": [
      {
        "id": "assistant",
        "assistantKey": "default",
        "label": "Assistant",
        "endpoint": "http",
        "path": "/assistant",
        "icon": "bot"
      },
      {
        "id": "pull-requests",
        "label": "Pull requests",
        "endpoint": "http",
        "path": "/pull-requests-panel",
        "icon": "git-pull-request"
      },
      {
        "id": "feedback",
        "label": "Feedback",
        "endpoint": "http",
        "path": "/feedback-panel",
        "icon": "message-square",
        "feedbackComposer": true
      }
    ]
  },
  "provides": [
    "assistant",
    "tasks",
    "task-executor",
    "conversation-history",
    "agent-sessions"
  ],
  "corePermissions": [
    "apps.read",
    "apps.workspaces.read",
    "apps.skills.read",
    "apps.sources.full",
    "apps.mcp.access.request",
    "skills.manage",
    "apps.feedback.manage",
    "decisions.request",
    "decisions.read",
    "decisions.respond",
    "providers.agent"
  ],
  "optionalCorePermissions": [
    "apps.workspaces.cleanup",
    "providers.speech-to-text",
    "core.read",
    "core.logs",
    "apps.logs",
    "apps.lifecycle",
    "apps.install",
    "core.lifecycle",
    "core.environments.read",
    "core.environments.manage",
    "core.workspace.activate",
    "providers.task-executor",
    "providers.tasks",
    "core.environments.inspect",
    "core.environments.operate",
    "core.environments.api",
    "core.publications.write",
    "core.tasks.read",
    "core.tasks.write",
    "core.tasks.execute",
    "providers.conversation-history",
    "core.history.read",
    "core.history.share",
    "core.history.export",
    "providers.agent-sessions",
    "core.agent-sessions.read",
    "core.agent-sessions.control"
  ]
}
