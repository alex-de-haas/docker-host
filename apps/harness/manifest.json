{
  "schemaVersion": "app.0.1",
  "id": "hosty.harness",
  "name": "Hosty Harness",
  "description": "Hosty assistant with Docker and Local production runtimes, managed Claude and Codex connections, chat and settings.",
  "version": "0.74.5",
  "role": "system",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/docker-host.git",
    "branch": "main"
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "local",
      "type": "localCommand"
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "api",
      "runtimes": {
        "local": {
          "type": "localCommand",
          "workingDirectory": "apps/harness",
          "command": "node scripts/local-runtime.mjs start api",
          "ports": [
            {
              "key": "http",
              "containerPort": 3400,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3400,
            "path": "/healthz",
            "timeoutSeconds": 5
          },
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "native",
            "NODE_ENV": "production"
          }
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/harness",
          "command": "npm run dev",
          "ports": [
            {
              "key": "http",
              "containerPort": 3400,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3400,
            "path": "/healthz",
            "timeoutSeconds": 5
          },
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "native"
          }
        },
        "docker": {
          "type": "docker",
          "image": "ghcr.io/alex-de-haas/hosty-harness:0.74.5",
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "docker",
            "PORT": "3400"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3400,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3400/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 20
          }
        }
      },
      "dependsOn": [
        "worker"
      ],
      "injection": {
        "settings": []
      }
    },
    {
      "key": "worker",
      "injection": {
        "appServiceToken": false,
        "appIdentityToken": false,
        "settings": []
      },
      "runtimes": {
        "local": {
          "type": "localCommand",
          "workingDirectory": "apps/harness",
          "setup": "node scripts/local-runtime.mjs prepare",
          "command": "node scripts/local-runtime.mjs start worker",
          "ports": [
            {
              "key": "worker",
              "containerPort": 3401,
              "protocol": "http",
              "public": false
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3401,
            "path": "/healthz",
            "timeoutSeconds": 5
          },
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "native",
            "NODE_ENV": "production"
          }
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/harness",
          "setup": "npm --prefix ../.. install && npm run build:web",
          "command": "npm run worker",
          "ports": [
            {
              "key": "worker",
              "containerPort": 3401,
              "protocol": "http",
              "public": false
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3401,
            "path": "/healthz",
            "timeoutSeconds": 5
          },
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "native"
          }
        },
        "docker": {
          "type": "docker",
          "image": "ghcr.io/alex-de-haas/hosty-harness-worker:0.74.5",
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "docker",
            "PORT": "3401"
          },
          "ports": [
            {
              "key": "worker",
              "containerPort": 3401,
              "protocol": "http",
              "public": false
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3401/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 20
          }
        }
      }
    }
  ],
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "api",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "local",
        "environment": "HOSTY_APP_DATA_DIR",
        "service": "api"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_DATA_DIR",
        "service": "api"
      },
      {
        "runtime": "docker",
        "service": "worker",
        "subPath": "worker-service",
        "environment": "HOSTY_APP_DATA_DIR",
        "containerPath": "/control/state"
      },
      {
        "runtime": "local",
        "service": "worker",
        "subPath": "worker-service",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "dev",
        "service": "worker",
        "subPath": "worker-service",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "docker",
        "service": "worker",
        "subPath": "service-auth",
        "mode": "ro",
        "environment": "HOSTY_WORKER_AUTH_DIR",
        "containerPath": "/control/auth"
      },
      {
        "runtime": "local",
        "service": "worker",
        "subPath": "service-auth",
        "mode": "ro",
        "environment": "HOSTY_WORKER_AUTH_DIR"
      },
      {
        "runtime": "dev",
        "service": "worker",
        "subPath": "service-auth",
        "mode": "ro",
        "environment": "HOSTY_WORKER_AUTH_DIR"
      }
    ]
  },
  "cache": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "api",
        "containerPath": "/app/cache",
        "environment": "HOSTY_APP_CACHE_DIR"
      },
      {
        "runtime": "local",
        "environment": "HOSTY_APP_CACHE_DIR",
        "service": "api"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_CACHE_DIR",
        "service": "api"
      },
      {
        "runtime": "docker",
        "service": "worker",
        "subPath": "worker-service",
        "environment": "HOSTY_APP_CACHE_DIR",
        "containerPath": "/control/cache"
      },
      {
        "runtime": "local",
        "service": "worker",
        "subPath": "worker-service",
        "environment": "HOSTY_APP_CACHE_DIR"
      },
      {
        "runtime": "dev",
        "service": "worker",
        "subPath": "worker-service",
        "environment": "HOSTY_APP_CACHE_DIR"
      },
      {
        "runtime": "docker",
        "service": "worker",
        "subPath": "worker-files",
        "environment": "HOSTY_WORKER_FILES_DIR",
        "containerPath": "/work"
      },
      {
        "runtime": "local",
        "service": "worker",
        "subPath": "worker-files",
        "environment": "HOSTY_WORKER_FILES_DIR"
      },
      {
        "runtime": "dev",
        "service": "worker",
        "subPath": "worker-files",
        "environment": "HOSTY_WORKER_FILES_DIR"
      }
    ]
  },
  "endpoints": [
    {
      "key": "http",
      "service": "api",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "interfaces": {
    "assistant": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/assistant/v1",
        "version": 1,
        "capabilities": [
          "attachments"
        ]
      }
    ],
    "translation": [
      {
        "key": "codex",
        "endpoint": "http",
        "path": "/api/translation/v1/codex",
        "version": 1,
        "capabilities": [
          "text",
          "markdown"
        ]
      },
      {
        "key": "claude",
        "endpoint": "http",
        "path": "/api/translation/v1/claude",
        "version": 1,
        "capabilities": [
          "text",
          "markdown"
        ]
      }
    ],
    "tasks": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/tasks/v1",
        "version": 1,
        "capabilities": [
          "markdown",
          "review",
          "resources",
          "events"
        ]
      }
    ],
    "task-executor": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/task-executor/v1",
        "version": 1,
        "capabilities": [
          "markdown",
          "options",
          "cancellation",
          "existing-workspace"
        ]
      }
    ]
  },
  "capabilities": [
    "logs"
  ],
  "catalogMetadata": {
    "icon": "assets/icon.svg",
    "summary": "Admin-only Hosty assistant with Docker and Local runtimes."
  },
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/development"
    },
    "settings": {
      "endpoint": "http",
      "path": "/settings"
    },
    "navigation": [
      {
        "label": "Harness",
        "endpoint": "http",
        "path": "/development"
      },
      {
        "label": "Tasks",
        "endpoint": "http",
        "path": "/tasks"
      }
    ],
    "panels": [
      {
        "id": "assistant",
        "label": "Assistant",
        "endpoint": "http",
        "path": "/assistant",
        "icon": "bot"
      }
    ]
  },
  "provides": [
    "assistant",
    "translation",
    "tasks",
    "task-executor"
  ],
  "corePermissions": [
    "apps.read",
    "apps.workspaces.read",
    "apps.skills.read",
    "apps.sources.full",
    "apps.mcp.access.request",
    "skills.manage"
  ],
  "optionalCorePermissions": [
    "apps.workspaces.cleanup",
    "providers.speech-to-text",
    "core.read",
    "core.logs",
    "apps.logs",
    "apps.lifecycle",
    "apps.install",
    "core.lifecycle",
    "apps.sandboxes.read",
    "apps.sandboxes.manage",
    "core.environments.read",
    "core.environments.manage",
    "core.workspace.activate",
    "providers.task-executor",
    "providers.tasks"
  ],
  "externalMounts": {
    "development": {
      "kind": "managed-workspaces",
      "scope": "instance",
      "service": "worker",
      "mode": "rw",
      "required": true
    },
    "skills": {
      "kind": "agent-skills",
      "scope": "instance",
      "service": "worker",
      "mode": "ro",
      "required": true
    }
  }
}
