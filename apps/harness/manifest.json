{
  "schemaVersion": "app.0.1",
  "id": "hosty.harness",
  "name": "Hosty Harness",
  "description": "Hosty assistant with Docker and Local production runtimes, managed Claude and Codex connections, chat and settings.",
  "version": "0.63.3",
  "role": "system",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/docker-host.git",
    "branch": "main"
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "local",
      "type": "localCommand"
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "api",
      "runtimes": {
        "local": {
          "type": "localCommand",
          "workingDirectory": "apps/harness",
          "setup": "npm --prefix ../.. ci && npm run build:web",
          "command": "npm run start",
          "ports": [
            {
              "key": "http",
              "containerPort": 3400,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3400,
            "path": "/healthz",
            "timeoutSeconds": 5
          },
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "native"
          }
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": "apps/harness",
          "setup": "npm --prefix ../.. install && npm run build:web",
          "command": "npm run dev",
          "ports": [
            {
              "key": "http",
              "containerPort": 3400,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3400,
            "path": "/healthz",
            "timeoutSeconds": 5
          }
        },
        "docker": {
          "type": "docker",
          "image": "ghcr.io/alex-de-haas/hosty-harness:0.63.3",
          "environment": {
            "HOSTY_HARNESS_RUNTIME": "docker",
            "PORT": "3400"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3400,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3400/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 20
          }
        }
      }
    }
  ],
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "api",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "local",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_DATA_DIR"
      }
    ]
  },
  "cache": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "api",
        "containerPath": "/app/cache",
        "environment": "HOSTY_APP_CACHE_DIR"
      },
      {
        "runtime": "local",
        "environment": "HOSTY_APP_CACHE_DIR"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_CACHE_DIR"
      }
    ]
  },
  "endpoints": [
    {
      "key": "http",
      "service": "api",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "interfaces": {
    "assistant": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/assistant/v1",
        "version": 1,
        "capabilities": [
          "attachments"
        ]
      }
    ],
    "translation": [
      {
        "key": "codex",
        "endpoint": "http",
        "path": "/api/translation/v1/codex",
        "version": 1,
        "capabilities": [
          "text",
          "markdown"
        ]
      },
      {
        "key": "claude",
        "endpoint": "http",
        "path": "/api/translation/v1/claude",
        "version": 1,
        "capabilities": [
          "text",
          "markdown"
        ]
      }
    ]
  },
  "settings": [
    {
      "key": "HOSTY_HARNESS_RETENTION_DAYS",
      "type": "string",
      "default": "30",
      "required": false,
      "label": "Transcript retention (days)",
      "description": "Initial ordinary-chat retention. Harness Settings \u2192 Instructions and retention overrides this value and separately controls verified completed workspaces. Unfinished work never expires."
    }
  ],
  "capabilities": [
    "logs"
  ],
  "catalogMetadata": {
    "icon": "assets/icon.svg",
    "summary": "Admin-only Hosty assistant with Docker and Local runtimes."
  },
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/development"
    },
    "settings": {
      "endpoint": "http",
      "path": "/settings"
    },
    "navigation": [
      {
        "label": "Harness",
        "endpoint": "http",
        "path": "/development"
      }
    ],
    "panels": [
      {
        "id": "assistant",
        "label": "Assistant",
        "endpoint": "http",
        "path": "/assistant",
        "icon": "bot"
      }
    ]
  },
  "provides": [
    "assistant",
    "translation"
  ],
  "corePermissions": [
    "apps.read",
    "apps.workspaces.read",
    "apps.skills.read",
    "apps.sources.full"
  ],
  "optionalCorePermissions": [
    "apps.workspaces.cleanup",
    "providers.speech-to-text",
    "core.read",
    "core.logs",
    "apps.logs",
    "apps.lifecycle",
    "apps.install",
    "core.lifecycle",
    "apps.sandboxes.read",
    "apps.sandboxes.manage",
    "core.environments.read",
    "core.environments.manage",
    "core.workspace.activate"
  ],
  "agentWorker": {
    "service": "api",
    "image": "ghcr.io/alex-de-haas/hosty-agent-worker:0.63.3"
  }
}
