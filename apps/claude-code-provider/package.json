{
  "name": "@hosty/claude-code-provider",
  "version": "0.7.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "start": "node dist/main.mjs",
    "dev": "tsx src/main.ts",
    "build": "node ../../packages/agent-provider-runtime/scripts/build.mjs claude-code-provider",
    "doctor": "node ../../packages/agent-provider-runtime/scripts/doctor.mjs claude",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hosty/agent-provider-runtime": "*",
    "@hosty-sdk/app": "*",
    "@anthropic-ai/claude-agent-sdk": "0.3.331"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "@types/node": "^24.19.2",
    "vitest": "^5.1.1"
  },
  "hostyAgentProvider": {
    "external": [
      "@anthropic-ai/claude-agent-sdk",
      "@anthropic-ai/claude-agent-sdk/*"
    ],
    "assets": [
      {
        "source": "src/adapter/claude-child-history.mjs",
        "target": "claude-child-history.mjs"
      }
    ],
    "nativeTests": [
      "test/native-controls.mjs",
      "test/native-background.mjs"
    ]
  }
}
