{
  "schemaVersion": "app.0.1",
  "id": "hosty.claude-code-provider",
  "name": "Claude Code Provider",
  "description": "Independent local Claude Code agent execution with app-owned connections, native sessions and Hosty-authorized HTTP/SSE.",
  "version": "0.1.0",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/docker-host.git",
    "branch": "main",
    "paths": [
      "apps/claude-code-provider",
      "packages/agent-provider-runtime",
      "packages/app-sdk",
      "package.json",
      "package-lock.json",
      "scripts/npm-workspace.mjs",
      "shared/web/hosty-theme.css",
      "shared/web/fonts",
      "apps/claude-code-provider/assets"
    ]
  },
  "runtimeProfiles": [
    {
      "key": "local",
      "type": "localCommand",
      "default": true
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    }
  ],
  "defaultRuntime": "local",
  "services": [
    {
      "key": "api",
      "runtimes": {
        "local": {
          "type": "localCommand",
          "workingDirectory": ".",
          "setup": "node packages/agent-provider-runtime/scripts/local-runtime.mjs prepare claude-code-provider",
          "command": "node packages/agent-provider-runtime/scripts/local-runtime.mjs start claude-code-provider",
          "ports": [
            {
              "key": "http",
              "containerPort": 3521,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3521,
            "path": "/healthz",
            "timeoutSeconds": 5
          }
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": ".",
          "setup": "node packages/agent-provider-runtime/scripts/local-runtime.mjs prepare claude-code-provider",
          "command": "node packages/agent-provider-runtime/scripts/local-runtime.mjs start claude-code-provider",
          "ports": [
            {
              "key": "http",
              "containerPort": 3521,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3521,
            "path": "/healthz",
            "timeoutSeconds": 5
          }
        }
      }
    }
  ],
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "local",
        "service": "api",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "dev",
        "service": "api",
        "environment": "HOSTY_APP_DATA_DIR"
      }
    ]
  },
  "cache": {
    "enabled": true,
    "targets": [
      {
        "runtime": "local",
        "service": "api",
        "environment": "HOSTY_APP_CACHE_DIR"
      },
      {
        "runtime": "dev",
        "service": "api",
        "environment": "HOSTY_APP_CACHE_DIR"
      }
    ]
  },
  "endpoints": [
    {
      "key": "http",
      "service": "api",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/settings"
    },
    "settings": {
      "endpoint": "http",
      "path": "/settings"
    }
  },
  "provides": [
    "agent"
  ],
  "interfaces": {
    "agent": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/agent/v1",
        "version": 1,
        "capabilities": [
          "session.resume",
          "configuration.resume-compatible",
          "configuration.approval-mode",
          "skills.catalog",
          "skills.exclusive-selection",
          "mcp.core",
          "mcp.apps",
          "workflow.consumer",
          "model.change-on-resume",
          "decisions.questions",
          "connections.usage",
          "runs.park",
          "runs.barrier",
          "native-tools.none",
          "decisions.deny-reason",
          "runs.live-configure",
          "predictions",
          "decisions.auto-allow",
          "mcp.policy-update",
          "runs.reconcile",
          "subagents.native"
        ]
      }
    ]
  },
  "corePermissions": [
    "decisions.request",
    "decisions.read",
    "decisions.respond"
  ],
  "capabilities": [
    "logs"
  ],
  "catalogMetadata": {
    "icon": "assets/icon.svg"
  }
}
