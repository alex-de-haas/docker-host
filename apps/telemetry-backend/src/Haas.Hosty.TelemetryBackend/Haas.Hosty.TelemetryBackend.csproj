<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Haas.Hosty.TelemetryBackend</RootNamespace>
    <AssemblyName>hosty-telemetry-backend</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IL (not AOT) for now: this is a container, startup time is not critical, and AOT + SQLite +
         ASP.NET trimming adds risk. Code is kept AOT-friendly (source-gen JSON, no reflection) so
         PublishAot can be enabled later. See docs/features/observability/feature.md. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Override the vulnerable SQLitePCLRaw.lib.e_sqlite3 2.1.11 that Microsoft.Data.Sqlite pulls
         transitively (NU1903 / GHSA-2m69-gcr7-jv3q) with the patched 3.x bundle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
