{
  "schemaVersion": "0.2",
  "id": "com.haas.demo-module",
  "name": "Demo Module",
  "description": "Small Next.js module for validating Docker Host module install, lifecycle, update, settings, storage, health, gateway authorization, identity propagation, and module directory flows.",
  "version": "0.2.0",
  "containers": [
    {
      "key": "app",
      "image": {
        "repository": "ghcr.io/alex-de-haas/demo-module",
        "tag": "latest",
        "pullPolicy": "always"
      },
      "runtime": {
        "ports": [
          {
            "key": "http",
            "containerPort": 3000,
            "protocol": "http"
          }
        ],
        "healthcheck": {
          "type": "http",
          "path": "/api/health",
          "expectedStatus": 200
        },
        "resources": {
          "cpus": 0.25,
          "memory": "256m"
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "http",
      "container": "app",
      "port": "http",
      "public": true
    }
  ],
  "settings": [
    {
      "key": "DEMO_GREETING",
      "type": "string",
      "required": false,
      "default": "Hello from Docker Host",
      "targets": [
        {
          "container": "app",
          "type": "env",
          "name": "DEMO_GREETING"
        }
      ]
    },
    {
      "key": "DEMO_RELEASE_CHANNEL",
      "type": "string",
      "required": false,
      "default": "local",
      "targets": [
        {
          "container": "app",
          "type": "env",
          "name": "DEMO_RELEASE_CHANNEL"
        }
      ]
    },
    {
      "key": "DEMO_REFRESH_SECONDS",
      "type": "number",
      "required": false,
      "default": 30,
      "targets": [
        {
          "container": "app",
          "type": "env",
          "name": "DEMO_REFRESH_SECONDS"
        }
      ]
    },
    {
      "key": "DEMO_AUTH_PREVIEW",
      "type": "boolean",
      "required": false,
      "default": true,
      "targets": [
        {
          "container": "app",
          "type": "env",
          "name": "DEMO_AUTH_PREVIEW"
        }
      ]
    },
    {
      "key": "DEMO_PUBLIC_URL",
      "type": "url",
      "required": false,
      "default": "http://localhost:3100",
      "targets": [
        {
          "container": "app",
          "type": "env",
          "name": "DEMO_PUBLIC_URL"
        }
      ]
    },
    {
      "key": "DEMO_PEOPLE_JSON",
      "type": "string",
      "required": false,
      "default": "[{\"id\":\"ada\",\"name\":\"Ada Lovelace\",\"role\":\"Module admin\",\"status\":\"active\"},{\"id\":\"grace\",\"name\":\"Grace Hopper\",\"role\":\"Runtime tester\",\"status\":\"active\"},{\"id\":\"katherine\",\"name\":\"Katherine Johnson\",\"role\":\"Release reviewer\",\"status\":\"invited\"}]",
      "targets": [
        {
          "container": "app",
          "type": "env",
          "name": "DEMO_PEOPLE_JSON"
        }
      ]
    }
  ],
  "storage": {
    "directories": [
      {
        "key": "data",
        "label": "Data",
        "description": "Writable demo module state and health-check probe data.",
        "purpose": "data",
        "required": true,
        "targets": [
          {
            "container": "app",
            "containerPath": "/app/data",
            "writable": true
          }
        ],
        "mount": {
          "recommended": true,
          "type": "bind",
          "modulePath": "data"
        }
      },
      {
        "key": "logs",
        "label": "Logs",
        "description": "Writable demo log output directory.",
        "purpose": "logs",
        "required": false,
        "targets": [
          {
            "container": "app",
            "containerPath": "/app/logs",
            "writable": true
          }
        ],
        "mount": {
          "recommended": true,
          "type": "bind",
          "modulePath": "logs"
        }
      }
    ],
    "mountCollections": [
      {
        "key": "external-sources",
        "label": "External sources",
        "description": "Optional host-selected folders surfaced by the demo UI.",
        "purpose": "data",
        "required": false,
        "minItems": 0,
        "maxItems": 4,
        "targets": [
          {
            "container": "app",
            "containerPathPrefix": "/mnt/sources",
            "itemContainerPathTemplate": "/mnt/sources/{key}",
            "writable": false
          }
        ],
        "hostPathPolicy": {
          "mode": "adminSelected",
          "allowExternal": true
        }
      }
    ]
  }
}
