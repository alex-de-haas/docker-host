{
  "schemaVersion": "0.3",
  "id": "com.haas.demo-module",
  "name": "Demo Module",
  "description": "Small Next.js module for validating Docker Host module install, lifecycle, update, multi-service metadata, settings, storage, health, gateway authorization, identity propagation, module directory, and module-owned role flows.",
  "version": "0.2.1",
  "services": [
    {
      "key": "backend",
      "source": {
        "type": "image",
        "image": {
          "repository": "ghcr.io/alex-de-haas/demo-module",
          "tag": "latest",
          "pullPolicy": "always"
        }
      },
      "runtime": {
        "ports": [
          {
            "key": "http",
            "containerPort": 3000,
            "protocol": "http"
          }
        ],
        "resources": {
          "cpus": 0.25,
          "memory": "256m"
        }
      },
      "healthCheck": {
        "type": "http",
        "path": "/api/health",
        "intervalSeconds": 10,
        "timeoutSeconds": 2,
        "successStatus": [200]
      }
    },
    {
      "key": "frontend",
      "dependsOn": ["backend"],
      "source": {
        "type": "image",
        "image": {
          "repository": "ghcr.io/alex-de-haas/demo-module",
          "tag": "latest",
          "pullPolicy": "always"
        }
      },
      "runtime": {
        "ports": [
          {
            "key": "http",
            "containerPort": 3000,
            "protocol": "http"
          }
        ],
        "resources": {
          "cpus": 0.25,
          "memory": "256m"
        }
      },
      "healthCheck": {
        "type": "http",
        "path": "/api/health",
        "intervalSeconds": 10,
        "timeoutSeconds": 2,
        "successStatus": [200]
      }
    }
  ],
  "endpoints": [
    {
      "key": "api",
      "service": "backend",
      "port": "http",
      "public": false
    },
    {
      "key": "http",
      "service": "frontend",
      "port": "http",
      "public": true
    }
  ],
  "connections": [
    {
      "source": {
        "type": "endpoint",
        "key": "api"
      },
      "targets": [
        {
          "container": "frontend",
          "type": "env",
          "name": "DEMO_BACKEND_BASE_URL"
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "DEMO_GREETING",
      "type": "string",
      "required": false,
      "default": "Hello from Docker Host",
      "targets": [
        {
          "container": "frontend",
          "type": "env",
          "name": "DEMO_GREETING"
        },
        {
          "container": "backend",
          "type": "env",
          "name": "DEMO_GREETING"
        }
      ]
    },
    {
      "key": "DEMO_RELEASE_CHANNEL",
      "type": "string",
      "required": false,
      "default": "local",
      "targets": [
        {
          "container": "frontend",
          "type": "env",
          "name": "DEMO_RELEASE_CHANNEL"
        },
        {
          "container": "backend",
          "type": "env",
          "name": "DEMO_RELEASE_CHANNEL"
        }
      ]
    },
    {
      "key": "DEMO_REFRESH_SECONDS",
      "type": "number",
      "required": false,
      "default": 30,
      "targets": [
        {
          "container": "frontend",
          "type": "env",
          "name": "DEMO_REFRESH_SECONDS"
        }
      ]
    },
    {
      "key": "DEMO_AUTH_PREVIEW",
      "type": "boolean",
      "required": false,
      "default": true,
      "targets": [
        {
          "container": "frontend",
          "type": "env",
          "name": "DEMO_AUTH_PREVIEW"
        }
      ]
    },
    {
      "key": "DEMO_PUBLIC_URL",
      "type": "url",
      "required": false,
      "default": "http://localhost:3100",
      "targets": [
        {
          "container": "frontend",
          "type": "env",
          "name": "DEMO_PUBLIC_URL"
        }
      ]
    }
  ],
  "storage": {
    "directories": [
      {
        "key": "data",
        "label": "Data",
        "description": "Writable demo module state and health-check probe data.",
        "purpose": "data",
        "required": true,
        "targets": [
          {
            "container": "backend",
            "containerPath": "/app/data",
            "writable": true
          },
          {
            "container": "frontend",
            "containerPath": "/app/data",
            "writable": true
          }
        ],
        "mount": {
          "recommended": true,
          "type": "bind",
          "modulePath": "data"
        }
      },
      {
        "key": "logs",
        "label": "Logs",
        "description": "Writable demo log output directory.",
        "purpose": "logs",
        "required": false,
        "targets": [
          {
            "container": "backend",
            "containerPath": "/app/logs",
            "writable": true
          },
          {
            "container": "frontend",
            "containerPath": "/app/logs",
            "writable": true
          }
        ],
        "mount": {
          "recommended": true,
          "type": "bind",
          "modulePath": "logs"
        }
      }
    ],
    "mountCollections": [
      {
        "key": "external-sources",
        "label": "External sources",
        "description": "Optional host-selected folders surfaced by the demo UI.",
        "purpose": "data",
        "required": false,
        "minItems": 0,
        "maxItems": 4,
        "targets": [
          {
            "container": "frontend",
            "containerPathPrefix": "/mnt/sources",
            "itemContainerPathTemplate": "/mnt/sources/{key}",
            "writable": false
          }
        ],
        "hostPathPolicy": {
          "mode": "adminSelected",
          "allowExternal": true
        }
      }
    ]
  },
  "ui": {
    "category": "Apps",
    "icon": "boxes",
    "entrypoint": {
      "portKey": "http",
      "path": "/"
    },
    "navigation": [
      {
        "label": "Overview",
        "path": "/"
      },
      {
        "label": "People",
        "path": "/people"
      },
      {
        "label": "Roles",
        "path": "/roles"
      },
      {
        "label": "Settings",
        "path": "/settings"
      }
    ]
  }
}
