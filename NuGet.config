<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins this repository's package sources. `dotnet` otherwise merges in the machine's global
  NuGet.config, so a developer with an unrelated private feed configured (a work Azure Artifacts
  feed, say) has every restore here block on that feed's authentication before it can reach
  nuget.org — which reads as a build that hangs for minutes with no output.

  Core takes exactly one package (the MCP SDK) and everything else here is public, so clearing the
  inherited list and naming nuget.org costs nothing and makes restores hermetic and fast on any
  machine, CI included.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
